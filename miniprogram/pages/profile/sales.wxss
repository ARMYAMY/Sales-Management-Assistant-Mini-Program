/* 个人中心页 - 优化版 */
.profile-page {
  padding-bottom: 48rpx;
  background: #F5F7FA;
  min-height: 100vh;
}

/* 用户信息卡片 - 蓝色渐变头部 */
.profile-header {
  margin: 0;
  padding: 48rpx 32rpx 40rpx;
  background: linear-gradient(135deg, #2B6FF2, #1a5bd9);
  border-radius: 0 0 32rpx 32rpx;
}

.profile-user {
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  margin-right: 24rpx;
  background-color: rgba(255,255,255,0.2);
  border: 3rpx solid rgba(255,255,255,0.3);
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.profile-team {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 6rpx;
}

.profile-join {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
}

/* 统计网格 - 悬浮卡片 */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 0 32rpx;
  margin-top: -32rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.stat-grid .stat-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  text-align: center;
}

.stat-grid .stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #2B6FF2;
  margin-bottom: 10rpx;
}

.stat-grid .stat-label {
  font-size: 24rpx;
  color: #86909C;
}

/* 菜单列表 */
.menu-list {
  margin: 0 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 8rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5F7FA;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F8F9FA;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #1A1A1A;
}

.menu-sub {
  font-size: 26rpx;
  color: #86909C;
  margin-right: 16rpx;
}

.menu-badge {
  font-size: 24rpx;
  color: #2B6FF2;
  background-color: #EBF1FE;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: #C9CDD4;
}

/* 退出登录 */
.logout-section {
  padding: 24rpx 32rpx;
}

.btn-logout {
  width: 100%;
  background-color: #FFFFFF;
  color: #EF4444;
  border: none;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-logout:active {
  background: #FFF5F5;
}

.btn-logout::after {
  border: none;
}
