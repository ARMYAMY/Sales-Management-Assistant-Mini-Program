.customer-page {
  padding-bottom: 40rpx;
  background: #F5F7FA;
  min-height: 100vh;
}

/* 统计概览 */
.customer-stats {
  background: linear-gradient(135deg, #2B6FF2, #1a5bd9);
  padding: 32rpx 24rpx 48rpx;
}
.stat-overview {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255,255,255,0.12);
  border-radius: 16rpx;
  padding: 28rpx 16rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.stat-num--core { color: #FEF3C7; }
.stat-num--deal { color: #D1FAE5; }
.stat-num--amount { color: #BFDBFE; }
.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.2);
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F5F7FA;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
}
.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  color: #9CA3AF;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1D2129;
}
.search-input::placeholder {
  color: #9CA3AF;
}
.search-clear {
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 8rpx;
}
.add-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2B6FF2, #1a5bd9);
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(43, 111, 242, 0.3);
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx 8rpx;
  background: #fff;
  border-bottom: 1rpx solid #F0F0F0;
  overflow-x: auto;
  white-space: nowrap;
}
.filter-tab {
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #6B7280;
  background: #F3F4F6;
  transition: all 0.2s;
  flex-shrink: 0;
}
.filter-tab--active {
  background: #2B6FF2;
  color: #FFFFFF;
  font-weight: 500;
}
.filter-count {
  font-size: 22rpx;
  margin-left: 4rpx;
  opacity: 0.8;
}

/* 客户列表 */
.customer-list {
  padding: 24rpx 32rpx;
}
.customer-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  position: relative;
  overflow: hidden;
}
.customer-card--core {
  border-left: 6rpx solid #F59E0B;
}
.core-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: linear-gradient(135deg, #F59E0B, #D97706);
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.customer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.customer-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  flex: 1;
  margin-right: 16rpx;
}
.customer-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.customer-industry {
  font-size: 22rpx;
  color: #6B7280;
  background: #F3F4F6;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.source-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 500;
}
.source-tag--visit {
  color: #166534;
  background: #DCFCE7;
}
.source-tag--manual {
  color: #92400E;
  background: #FEF3C7;
}

.customer-meta {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
}
.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.meta-icon {
  font-size: 24rpx;
}
.meta-text {
  font-size: 24rpx;
  color: #6B7280;
}

.customer-metrics {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #F0F0F0;
  border-bottom: 1rpx solid #F0F0F0;
}
.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.metric-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D2129;
}
.metric-num--amount {
  font-size: 28rpx;
  color: #EF4444;
}
.metric-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}
.metric-divider {
  width: 1rpx;
  height: 48rpx;
  background: #F0F0F0;
}

.metric-stage {
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.stage-done { background: #DCFCE7; color: #166534; }
.stage-intent { background: #DBEAFE; color: #1E40AF; }
.stage-progress { background: #FEF3C7; color: #92400E; }
.stage-default { background: #F3F4F6; color: #6B7280; }

/* 最近拜访摘要 */
.recent-visit {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
}
.recent-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #2B6FF2;
  background: #EFF4FF;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 500;
}
.recent-text {
  font-size: 24rpx;
  color: #4B5563;
  line-height: 1.5;
}

/* 拜访预警 */
.visit-warning {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #EF4444;
  background: #FEF2F2;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
}
.warning-icon {
  font-size: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 30rpx;
  color: #9CA3AF;
  margin-bottom: 12rpx;
}
.empty-hint {
  font-size: 26rpx;
  color: #D1D5DB;
}

/* 空状态添加按钮 */
.add-hint {
  margin-top: 32rpx;
}
.add-hint-btn {
  display: inline-block;
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, #2B6FF2, #1a5bd9);
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(43, 111, 242, 0.25);
}

/* 添加客户弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}
.modal-content {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #FFFFFF;
  border-radius: 24rpx;
  z-index: 201;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 0;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
}
.modal-close {
  font-size: 32rpx;
  color: #9CA3AF;
  padding: 8rpx;
}
.modal-body {
  padding: 24rpx 32rpx;
  overflow-y: auto;
  flex: 1;
}
.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx 32rpx;
  border-top: 1rpx solid #F0F0F0;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.modal-btn--cancel {
  background: #F3F4F6;
  color: #6B7280;
}
.modal-btn--confirm {
  background: linear-gradient(135deg, #2B6FF2, #1a5bd9);
  color: #FFFFFF;
}

/* 表单样式 */
.form-item {
  margin-bottom: 24rpx;
}
.form-item--row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.form-label {
  font-size: 28rpx;
  color: #4B5563;
  margin-bottom: 12rpx;
}
.form-item--row .form-label {
  margin-bottom: 0;
}
.required {
  color: #EF4444;
}
.form-input {
  width: 100%;
  height: 80rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1D2129;
  box-sizing: border-box;
}
.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #1D2129;
  box-sizing: border-box;
}

/* 骨架屏 */
.skeleton {
  background: #F5F7FA;
  border-radius: 8rpx;
}
.skeleton-line {
  background: #E5E7EB;
  border-radius: 4rpx;
}
