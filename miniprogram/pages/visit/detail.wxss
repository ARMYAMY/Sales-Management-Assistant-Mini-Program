/* 拜访详情页 */
.detail-page {
  padding-bottom: 160rpx;
}

/* 顶部状态栏 */
.detail-header {
  background-color: #FFFFFF;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-status {
  font-size: 28rpx;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
}

.detail-status.completed {
  color: #07c160;
  background-color: #e8f8ef;
}

.detail-status.pending {
  color: #ff9500;
  background-color: #fff5e6;
}

.detail-status.cancelled {
  color: #999999;
  background-color: #f5f5f5;
}

.detail-date {
  font-size: 28rpx;
  color: #86909C;
}

/* 详情区块标题 */
.detail-section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

/* 详情行 */
.detail-row {
  display: flex;
  margin-bottom: 20rpx;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #86909C;
  flex-shrink: 0;
}

.detail-value {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  word-break: break-all;
}

/* 详情文本块 */
.detail-block {
  margin-bottom: 24rpx;
}

.detail-block:last-child {
  margin-bottom: 0;
}

.detail-block-title {
  font-size: 28rpx;
  color: #86909C;
  margin-bottom: 12rpx;
}

.detail-block-content {
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.6;
  word-break: break-all;
}

/* 底部操作 */
.detail-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 24rpx 32rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
  z-index: 100;
}
