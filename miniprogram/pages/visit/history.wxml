<!--pages/visit/history.wxml - 拜访历史-->
<view class="history-page">
  <!-- 蓝色头部 -->
  <view class="history-header">
    <view class="history-header-top">
      <text class="history-title">拜访历史</text>
      <text class="history-count">共 {{total}} 条</text>
    </view>
    <view class="filter-bar">
      <view class="filter-item {{currentFilter === 'all' ? 'filter-item--active' : ''}}"
            bindtap="onFilter" data-type="all">全部</view>
      <view class="filter-item {{currentFilter === 'core' ? 'filter-item--active' : ''}}"
            bindtap="onFilter" data-type="core">核心客户</view>
      <view class="filter-item {{currentFilter === 'week' ? 'filter-item--active' : ''}}"
            bindtap="onFilter" data-type="week">本周</view>
    </view>
  </view>

  <!-- 加载骨架屏 -->
  <view wx:if="{{loading && visitList.length === 0}}" class="visit-list">
    <view class="visit-card skeleton" wx:for="{{4}}" wx:key="index" style="padding:32rpx;height:160rpx;">
      <view style="width:40%;height:32rpx;margin-bottom:20rpx;border-radius:8rpx;" class="skeleton"></view>
      <view style="width:60%;height:28rpx;border-radius:8rpx;" class="skeleton"></view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{visitList.length === 0}}">
    <view class="empty-icon">📋</view>
    <view class="empty-text">暂无拜访记录</view>
    <view class="empty-action">
      <button class="btn-primary" bindtap="goToRecord">去录入</button>
    </view>
  </view>

  <!-- 拜访列表 -->
  <view class="visit-list" wx:else>
    <view class="visit-card {{'result-' + item.resultClass}}"
          wx:for="{{visitList}}"
          wx:key="_id"
          bindtap="goToDetail"
          data-id="{{item._id}}">

      <!-- 卡片左侧状态条 -->
      <view class="card-left-bar"></view>

      <!-- 卡片内容 -->
      <view class="card-body">
        <!-- 第一行：客户名称 + 核心标记 + 时间 -->
        <view class="card-row card-row-primary">
          <view class="customer-wrap">
            <text class="customer-name">{{item.customerName || '未命名客户'}}</text>
            <text wx:if="{{item.isCoreCustomer}}" class="core-badge">核心</text>
          </view>
          <text class="visit-date">{{item.dateLabel}}</text>
        </view>

        <!-- 第二行：联系人 + 拜访方式 -->
        <view class="card-row card-row-secondary">
          <text class="contact-person" wx:if="{{item.contactPerson}}">联系人：{{item.contactPerson}}</text>
          <text class="location-tag" wx:if="{{item.location}}">{{item.location}}</text>
        </view>

        <!-- 第三行：阶段标签 + 结果标签 + 金额 -->
        <view class="card-row card-row-tags">
          <view class="tag-group">
            <text class="tag tag-stage">{{item.stage || '未分类'}}</text>
            <text class="tag tag-result tag-result-{{item.resultClass}}">{{item.result || '未记录'}}</text>
          </view>
          <text class="visit-amount" wx:if="{{item.amount}}">¥{{item.amountLabel}}</text>
        </view>
      </view>
    </view>

    <!-- 上拉加载更多 -->
    <view class="load-more" wx:if="{{!noMore}}">
      <text wx:if="{{loading}}">加载中...</text>
    </view>
    <view class="no-more" wx:else>
      <text>没有更多了</text>
    </view>
  </view>
</view>