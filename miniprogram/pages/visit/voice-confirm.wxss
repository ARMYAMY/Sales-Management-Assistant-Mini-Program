/* pages/visit/voice-confirm.wxss */
.voice-page {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding: 0 32rpx 48rpx;
  box-sizing: border-box;
}

/* 顶部说明 */
.voice-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}

.voice-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.voice-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.voice-desc {
  font-size: 26rpx;
  color: #86909C;
  text-align: center;
}

/* 录音区域 */
.voice-record-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

/* 波形动画 */
.wave-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  margin-bottom: 24rpx;
  gap: 8rpx;
}

.wave-bar {
  width: 8rpx;
  height: 20rpx;
  background-color: #2B6FF2;
  border-radius: 4rpx;
  opacity: 0.3;
  transition: all 0.3s ease;
}

.wave-bar.active {
  animation: wave 0.8s ease-in-out infinite;
}

@keyframes wave {
  0%, 100% { height: 20rpx; opacity: 0.3; }
  50% { height: 60rpx; opacity: 1; }
}

/* 计时 */
.record-timer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.timer-text {
  font-size: 48rpx;
  font-weight: 600;
  color: #2B6FF2;
  font-variant-numeric: tabular-nums;
}

.timer-hint {
  font-size: 24rpx;
  color: #86909C;
  margin-top: 8rpx;
}

/* 录音按钮 */
.record-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(43, 111, 242, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  position: relative;
}

.record-btn::before {
  content: '';
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(43, 111, 242, 0.15);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.1); opacity: 0.5; }
}

.record-btn.recording {
  background-color: #EF4444;
  box-shadow: 0 8rpx 32rpx rgba(239, 68, 68, 0.3);
}

.record-btn.recording::before {
  border-color: rgba(239, 68, 68, 0.2);
}

.record-btn.disabled {
  opacity: 0.5;
}

.record-btn-inner {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #2B6FF2;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.record-btn.recording .record-btn-inner {
  background-color: #FFFFFF;
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
}

.record-icon {
  font-size: 64rpx;
  color: #FFFFFF;
  line-height: 1;
}

.record-btn.recording .record-icon {
  color: #EF4444;
  font-size: 40rpx;
}

.record-hint {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #86909C;
}

/* 识别结果卡片 */
.result-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.result-confidence {
  font-size: 24rpx;
  color: #22C55E;
  background-color: #F0FDF4;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.result-text {
  font-size: 28rpx;
  color: #4E5969;
  line-height: 1.8;
  padding: 20rpx;
  background-color: #F5F7FA;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.result-actions-mini {
  display: flex;
  justify-content: flex-end;
}

.re-record-link {
  font-size: 28rpx;
  color: #2B6FF2;
  padding: 8rpx 16rpx;
}

/* 分区标题 */
.section-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin: 40rpx 0 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #2B6FF2;
}

/* 表单卡片 */
.form-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #4E5969;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.required {
  color: #EF4444;
  margin-right: 8rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background-color: #F5F7FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}

.input-placeholder {
  color: #C9CDD4;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.input-arrow {
  position: absolute;
  right: 24rpx;
  font-size: 24rpx;
  color: #86909C;
}

/* 日期时间选择 */
.datetime-picker {
  display: flex;
  gap: 24rpx;
}

.datetime-picker picker {
  flex: 1;
}

.picker-value {
  height: 88rpx;
  line-height: 88rpx;
  background-color: #F5F7FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1A1A1A;
}

.picker-value.placeholder {
  color: #C9CDD4;
}

.picker-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.picker-wrap .picker-value {
  width: 100%;
  padding-right: 60rpx;
  box-sizing: border-box;
}

/* 单选按钮组 */
.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-btn {
  padding: 16rpx 32rpx;
  background-color: #F5F7FA;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #4E5969;
  transition: all 0.2s;
}

.radio-btn--active {
  background-color: #2B6FF2;
  color: #FFFFFF;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background-color: #F5F7FA;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}

/* 复选框 */
.checkbox-wrap {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #C9CDD4;
  border-radius: 10rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FFFFFF;
  transition: all 0.2s;
}

.checkbox--checked {
  background-color: #2B6FF2;
  border-color: #2B6FF2;
}

.checkbox--disabled {
  opacity: 0.6;
}

.checkbox-label {
  font-size: 28rpx;
  color: #4E5969;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 48rpx;
  margin-bottom: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #2B6FF2 0%, #4B8BF4 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(43, 111, 242, 0.3);
}

.submit-btn[disabled] {
  background: #C9CDD4;
  box-shadow: none;
}

.submit-btn::after {
  border: none;
}

/* 提示卡片 */
.tips-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tips-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tip-item {
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.6;
}
