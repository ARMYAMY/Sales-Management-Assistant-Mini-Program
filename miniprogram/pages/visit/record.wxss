/* pages/visit/record.wxss - 录入拜访 */

.record-page { padding-bottom: 160rpx; }

/* 顶部 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.header-voice {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #2B6FF2;
  padding: 14rpx 28rpx;
  background: linear-gradient(135deg, rgba(43,111,242,0.1), rgba(43,111,242,0.04));
  border-radius: 32rpx;
  font-weight: 500;
}

.header-voice::before {
  content: '🎙️';
  font-size: 28rpx;
}

/* 表单卡片 */
.form-card {
  margin: 24rpx 32rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}

/* 区块标题 */
.section-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin: 0 32rpx 16rpx;
  padding-top: 24rpx;
}

.section-label::before,
.section-label::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #E5E7EB, transparent);
}

/* 表单组 */
.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-child { margin-bottom: 0; }

.form-label {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #374151;
  margin-bottom: 16rpx;
}

.required {
  color: #EF4444;
  margin-right: 4rpx;
}

/* 输入框 */
.form-input {
  height: 96rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #1A1A1A;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.form-input:focus {
  background: #FFFFFF;
  border-color: #2B6FF2;
}

.input-placeholder { color: #9CA3AF; }

/* 输入框包裹（带箭头） */
.input-wrap {
  display: flex;
  align-items: center;
  background: #F9FAFB;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.input-wrap:focus-within {
  background: #FFFFFF;
  border-color: #2B6FF2;
}

.input-wrap .form-input {
  flex: 1;
  background: transparent;
  border: none;
}

.input-arrow {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-right: 28rpx;
  flex-shrink: 0;
  transition: transform 0.2s;
}

.input-wrap:focus-within .input-arrow {
  transform: rotate(180deg);
  color: #2B6FF2;
}

/* 搜索建议 */
.suggest-list {
  background: #FFFFFF;
  border-radius: 0 0 12rpx 12rpx;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,0.12);
  max-height: 320rpx;
  overflow-y: auto;
  position: relative;
  z-index: 10;
  margin-top: -4rpx;
  border: 2rpx solid #E5E7EB;
  border-top: none;
}

.suggest-item {
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  border-bottom: 1rpx solid #F3F4F6;
  transition: background 0.15s;
}

.suggest-item:last-child { border-bottom: none; }

.suggest-item:active { background: #EFF6FF; }

/* 日期时间选择器 */
.datetime-picker {
  display: flex;
  gap: 20rpx;
}

.datetime-picker picker { flex: 1; }

.picker-value {
  height: 96rpx;
  line-height: 96rpx;
  padding: 0 28rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: #1A1A1A;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.picker-value.placeholder { color: #9CA3AF; }

/* Picker 包裹 */
.picker-wrap {
  display: flex;
  align-items: center;
  height: 96rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 0 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.picker-wrap .picker-value {
  flex: 1;
  background: transparent;
  padding: 0;
  border: none;
  height: auto;
  line-height: normal;
}

/* 单选按钮组 */
.radio-group {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.radio-btn {
  padding: 20rpx 36rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #4B5563;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  font-weight: 500;
}

.radio-btn--active {
  background: #EFF6FF;
  border-color: #2B6FF2;
  color: #2B6FF2;
  font-weight: 600;
}

/* 复选框 */
.checkbox-wrap {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid #D1D5DB;
  border-radius: 10rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #FFFFFF;
  transition: all 0.2s;
  flex-shrink: 0;
}

.checkbox--checked {
  background: #2B6FF2;
  border-color: #2B6FF2;
}

.checkbox--disabled {
  opacity: 0.4;
}

.checkbox-label {
  font-size: 30rpx;
  color: #374151;
  font-weight: 500;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 提交按钮 */
.submit-btn {
  margin: 48rpx 32rpx 0;
  width: calc(100% - 64rpx) !important;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(43,111,242,0.3);
}

.submit-btn[disabled] {
  background: #D1D5DB !important;
  color: #9CA3AF !important;
  box-shadow: none;
}
