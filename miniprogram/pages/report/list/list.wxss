/* pages/report/list/list.wxss */
.report-list-page {
  padding: 24rpx;
  background: #F5F7FA;
  min-height: 100vh;
}

/* 快捷入口 */
.quick-generate {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.quick-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  transition: transform 0.2s;
}

.quick-card:active {
  transform: scale(0.98);
}

.quick-card--daily {
  border-top: 4rpx solid #2B6FF2;
}

.quick-card--weekly {
  border-top: 4rpx solid #10B981;
}

.quick-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.quick-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 8rpx;
}

.quick-desc {
  font-size: 24rpx;
  color: #86909C;
}

/* 标签栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  position: relative;
  transition: all 0.3s;
}

.tab-item--active {
  background: #E8F0FE;
}

.tab-item--active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 4rpx;
  background: #2B6FF2;
  border-radius: 2rpx;
}

.tab-text {
  font-size: 30rpx;
  color: #4E5969;
  font-weight: 500;
}

.tab-item--active .tab-text {
  color: #2B6FF2;
  font-weight: 600;
}

/* 日期选择 */
.date-picker-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.date-label {
  font-size: 26rpx;
  color: #86909C;
  margin-bottom: 16rpx;
}

.date-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F5F7FA;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
}

.date-text {
  font-size: 32rpx;
  color: #1D2129;
  font-weight: 500;
}

.date-arrow {
  font-size: 24rpx;
  color: #86909C;
}

/* 生成按钮 */
.btn-generate {
  background: #2B6FF2;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 12rpx;
  margin-bottom: 32rpx;
  border: none;
}

.btn-generate::after {
  border: none;
}

.btn-generate--loading {
  background: #94B3F2;
}

/* 历史报告 */
.history-section {
  margin-top: 8rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

.history-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F2F3F5;
  position: relative;
}

.history-item:last-child {
  border-bottom: none;
}

.history-item:active {
  background: #F5F7FA;
}

.history-left {
  flex: 1;
  min-width: 0;
}

.history-badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-bottom: 8rpx;
}

.history-badge--daily {
  background: #E8F0FE;
  color: #2B6FF2;
}

.history-badge--weekly {
  background: #D1FAE5;
  color: #059669;
}

.history-title {
  font-size: 30rpx;
  color: #1D2129;
  font-weight: 500;
}

.history-right {
  text-align: right;
  margin-right: 24rpx;
}

.history-meta {
  font-size: 26rpx;
  color: #4E5969;
  margin-bottom: 4rpx;
}

.history-date {
  font-size: 22rpx;
  color: #86909C;
}

.history-delete {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  color: #C9CDD4;
  font-size: 40rpx;
  border-radius: 50%;
}

.history-delete:active {
  background: #F2F3F5;
  color: #F53F3F;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #4E5969;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #86909C;
}
