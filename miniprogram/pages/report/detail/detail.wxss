/* pages/report/detail/detail.wxss */
.report-detail-page {
  padding: 24rpx 24rpx 140rpx;
  background: #F5F7FA;
  min-height: 100vh;
}

/* 加载 */
.loading-wrap {
  text-align: center;
  padding: 200rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #86909C;
}

/* 顶部标题 */
.report-header {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.report-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.report-badge--daily {
  background: #E8F0FE;
  color: #2B6FF2;
}

.report-badge--weekly {
  background: #D1FAE5;
  color: #059669;
}

.report-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D2129;
  margin-bottom: 12rpx;
}

.report-meta {
  font-size: 26rpx;
  color: #86909C;
}

.report-source {
  color: #F59E0B;
  margin-left: 8rpx;
}

/* 统计概览 */
.stats-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.stat-box {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
}

.stat-box-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #2B6FF2;
  margin-bottom: 8rpx;
}

.stat-box-label {
  font-size: 24rpx;
  color: #86909C;
}

/* 标签切换 */
.detail-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.detail-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #4E5969;
  position: relative;
  transition: all 0.3s;
}

.detail-tab--active {
  color: #2B6FF2;
  font-weight: 600;
  background: #E8F0FE;
}

/* AI 卡片 */
.ai-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.ai-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 16rpx;
}

.ai-card-body {
  font-size: 28rpx;
  color: #4E5969;
  line-height: 1.7;
}

.ai-card-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-card-item {
  font-size: 28rpx;
  color: #4E5969;
  padding-left: 24rpx;
  position: relative;
  line-height: 1.6;
}

.ai-card-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 8rpx;
  height: 8rpx;
  background: #2B6FF2;
  border-radius: 50%;
}

/* 分布条形图 */
.dist-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dist-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.dist-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #4E5969;
  text-align: right;
  flex-shrink: 0;
}

.dist-bar-wrap {
  flex: 1;
  height: 24rpx;
  background: #F2F3F5;
  border-radius: 12rpx;
  overflow: hidden;
}

.dist-bar {
  height: 100%;
  background: #2B6FF2;
  border-radius: 12rpx;
  min-width: 4rpx;
  transition: width 0.5s ease;
}

.dist-bar--result {
  background: #10B981;
}

.dist-value {
  width: 80rpx;
  font-size: 24rpx;
  color: #86909C;
  text-align: right;
  flex-shrink: 0;
}

/* 拜访列表 */
.visit-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.visit-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.visit-item-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.visit-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

.visit-item-time {
  font-size: 24rpx;
  color: #86909C;
}

.visit-item-mid {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.visit-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.visit-tag--purpose {
  background: #E8F0FE;
  color: #2B6FF2;
}

.visit-tag--result {
  background: #F0F9FF;
  color: #0EA5E9;
}

.visit-tag--core {
  background: #FEF3C7;
  color: #D97706;
}

.visit-item-bot {
  font-size: 26rpx;
  color: #4E5969;
}

.visit-next-label {
  color: #86909C;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #86909C;
}

/* 底部操作栏 */
.detail-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #F2F3F5;
  z-index: 100;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.action-btn--copy {
  background: #F5F7FA;
  color: #4E5969;
}

.action-btn--share {
  background: #2B6FF2;
  color: #fff;
  border: none;
  margin: 0;
  padding: 0;
}

.action-btn--share::after {
  border: none;
}

.action-icon {
  font-size: 32rpx;
}
