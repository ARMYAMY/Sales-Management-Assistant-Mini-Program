<!--pages/distill/progress.wxml - 蒸馏进度页（设计文档4.3.4）-->
<view class="page">
  <view class="header">
    <view class="header-title">蒸馏进行中...</view>
  </view>

  <!-- 圆形进度 -->
  <view class="progress-ring-wrap">
    <view class="progress-ring">
      <view class="progress-num">{{progress}}%</view>
    </view>
  </view>

  <!-- 当前步骤 -->
  <view class="step-title">{{currentStep}}</view>

  <!-- 步骤列表 -->
  <view class="step-list">
    <view class="step-item {{item.status}}" wx:for="{{steps}}" wx:key="name">
      <view class="step-icon">
        <text wx:if="{{item.status === 'done'}}">✅</text>
        <text wx:elif="{{item.status === 'running'}}">⏳</text>
        <text wx:else>⏸</text>
      </view>
      <view class="step-name">{{item.name}}</view>
    </view>
  </view>

  <!-- 分隔线 -->
  <view class="divider">─────────────────────</view>
  <view class="waiting-text">等待 Persona 分析...</view>

  <!-- 预计时间 -->
  <view class="time-hint">预计剩余 {{estimatedTime}}</view>

  <!-- 最小化按钮 -->
  <view class="minimize-btn" bindtap="minimize">
    [最小化到后台]
  </view>
  <view class="notify-hint">完成后会推送通知</view>

  <view style="height:60rpx;"></view>
</view>
