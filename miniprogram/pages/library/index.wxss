/* pages/library/index.wxss */
.page {
  background-color: #F3F4F6;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  background-color: #FFFFFF;
  padding: 32rpx;
  border-bottom: 2rpx solid #F3F4F6;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
}

.header-desc {
  font-size: 26rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

/* 维度切换 */
.dimension-bar {
  display: flex;
  justify-content: center;
  background-color: #FFFFFF;
  padding: 20rpx 32rpx 0;
  gap: 8rpx;
}
.dim-tab {
  font-size: 26rpx;
  color: #6B7280;
  padding: 10rpx 32rpx;
  border-radius: 28rpx;
  background-color: #F3F4F6;
  transition: all 0.2s;
}
.dim-tab.active {
  background-color: #3B82F6;
  color: #FFFFFF;
  font-weight: 600;
}

/* 分类标签 */
.category-tabs {
  background-color: #FFFFFF;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F3F4F6;
}

.tab-scroll {
  white-space: nowrap;
}

.tab-list {
  display: inline-flex;
  padding: 0 32rpx;
  gap: 16rpx;
}

.cat-tab {
  font-size: 26rpx;
  color: #6B7280;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  background-color: #F3F4F6;
  white-space: nowrap;
}

.cat-tab.active {
  background-color: #EFF6FF;
  color: #3B82F6;
  font-weight: 600;
}

/* 区块 */
.section {
  padding: 24rpx 32rpx;
}

/* 技能卡片 */
.skill-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.skill-header {
  display: flex;
  align-items: flex-start;
}

.skill-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.skill-info {
  flex: 1;
}

.skill-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.skill-desc {
  font-size: 26rpx;
  color: #6B7280;
  margin-top: 8rpx;
  line-height: 1.5;
}

.skill-arrow {
  font-size: 36rpx;
  color: #D1D5DB;
  margin-left: 16rpx;
}

/* 销售员信息 */
.sales-info {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  gap: 10rpx;
}
.sales-avatar {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}
.sales-name {
  font-size: 24rpx;
  color: #6B7280;
}

/* 标签 */
.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  font-size: 22rpx;
  color: #3B82F6;
  background-color: #EFF6FF;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

/* 统计 */
.skill-stats {
  display: flex;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #F3F4F6;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.stat-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

/* 预览 */
.script-preview {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: #F9FAFB;
  border-radius: 12rpx;
  border-left: 6rpx solid #3B82F6;
}

.preview-label {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-bottom: 8rpx;
}

.preview-text {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.6;
}

/* 浮动按钮 */
.float-btn {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  background-color: #3B82F6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4);
}

.float-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
}
