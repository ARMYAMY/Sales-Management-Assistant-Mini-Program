/* pages/library/detail/index.wxss */
.page {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 140rpx;
}

.detail-header {
  background: linear-gradient(135deg, #2B6FF2 0%, #5B8DEF 100%);
  padding: 48rpx 32rpx 40rpx;
  color: #fff;
}

.detail-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.detail-desc {
  font-size: 26rpx;
  opacity: 0.9;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.detail-tags {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}

.detail-tags .tag {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.detail-rating-row {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rating-label {
  font-size: 26rpx;
  opacity: 0.95;
}

.rating-stars {
  display: flex;
  gap: 8rpx;
}

.star {
  font-size: 36rpx;
  line-height: 1;
}

.star-full { color: #FFD700; }
.star-empty { color: rgba(255, 255, 255, 0.4); }
.star-clickable { cursor: pointer; }

.rating-text {
  font-size: 24rpx;
  margin-left: auto;
  opacity: 0.95;
}

.rating-empty {
  opacity: 0.7;
}

.stats-card {
  background: #fff;
  margin: -32rpx 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 32rpx 0;
  display: flex;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stat {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #F0F0F0;
}

.stat:last-child { border-right: none; }

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2B6FF2;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #888;
  margin-top: 8rpx;
}

.section {
  background: #fff;
  margin: 0 24rpx 24rpx;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.detail-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.85;
  white-space: pre-wrap;
  word-break: break-word;
}

.preview-card {
  background: linear-gradient(135deg, #EEF4FF 0%, #F8FAFF 100%);
  border-left: 6rpx solid #2B6FF2;
  border-radius: 12rpx;
  padding: 24rpx;
}

.preview-text {
  font-size: 28rpx;
  color: #1A1A1A;
  line-height: 1.75;
  display: block;
}

.copy-btn {
  margin-top: 16rpx;
  display: inline-block;
  background: #2B6FF2;
  color: #fff;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
}

.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
}

.btn-use {
  background: linear-gradient(135deg, #2B6FF2 0%, #5B8DEF 100%);
  color: #fff;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border-radius: 50rpx;
}

.empty {
  padding: 200rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
