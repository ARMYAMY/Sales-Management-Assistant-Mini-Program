<view class="page">
  <!-- 头部 -->
  <view class="header">
    <view class="header-title">话术库</view>
    <view class="header-desc">Top Sales 技能包 & 话术模板</view>
  </view>

  <!-- 维度切换 -->
  <view class="dimension-bar">
    <view class="dim-tab {{activeDimension === 'scene' ? 'active' : ''}}" bindtap="setDimension" data-dim="scene">按场景</view>
    <view class="dim-tab {{activeDimension === 'sales' ? 'active' : ''}}" bindtap="setDimension" data-dim="sales">按销售员</view>
  </view>

  <!-- 分类标签 -->
  <view class="category-tabs">
    <scroll-view scroll-x class="tab-scroll" show-scrollbar="false">
      <view class="tab-list">
        <view class="cat-tab {{activeCategory === 'all' ? 'active' : ''}}" bindtap="setCategory" data-cat="all">全部</view>
        <block wx:if="{{activeDimension === 'scene'}}">
          <view class="cat-tab {{activeCategory === item.key ? 'active' : ''}}"
                wx:for="{{categories}}" wx:key="key" bindtap="setCategory" data-cat="{{item.key}}">
            {{item.name}}
          </view>
        </block>
        <block wx:if="{{activeDimension === 'sales'}}">
          <view class="cat-tab {{activeCategory === item.key ? 'active' : ''}}"
                wx:for="{{salesList}}" wx:key="key" bindtap="setCategory" data-cat="{{item.key}}">
            {{item.name}}
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <!-- 技能包列表 -->
  <view class="section">
    <view class="skill-list">
      <view class="skill-card" wx:for="{{skills}}" wx:key="_id" wx:for-item="skill" bindtap="goDetail" data-id="{{skill._id}}">
        <view class="skill-header">
          <view class="skill-icon">{{skill.icon}}</view>
          <view class="skill-info">
            <view class="skill-name">{{skill.name}}</view>
            <view class="skill-desc">{{skill.description}}</view>
          </view>
          <view class="skill-arrow">›</view>
        </view>

        <!-- 销售员信息 -->
        <view class="sales-info" wx:if="{{skill.salesInfo}}">
          <view class="sales-avatar" style="background-color: {{skill.salesInfo.color}};">{{skill.salesInfo.avatar}}</view>
          <text class="sales-name">{{skill.salesInfo.name}}</text>
        </view>

        <!-- 标签 -->
        <view class="skill-tags" wx:if="{{skill.tags.length > 0}}">
          <view class="tag" wx:for="{{skill.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</view>
        </view>

        <!-- 打星区域 -->
        <view class="star-row" catchtap="noop">
          <view class="star-label">管理者评级</view>
          <view class="stars">
            <view
              class="star {{skill.ratingStars[starIdx - 1] === 'full' ? 'star-full' : 'star-empty'}} {{isManager ? 'star-clickable' : ''}}"
              wx:for="{{starArr}}"
              wx:for-item="starIdx"
              wx:for-index="si"
              wx:key="si"
              catchtap="rateSkill"
              data-id="{{skill._id}}"
              data-star="{{starIdx}}"
            >★</view>
          </view>
          <text class="star-score" wx:if="{{skill.managerRating > 0}}">{{skill.managerRating}}星</text>
          <text class="star-unrated" wx:else>{{isManager ? '点击评分' : '暂未评级'}}</text>
        </view>

        <!-- 统计 -->
        <view class="skill-stats">
          <view class="stat">
            <text class="stat-num">{{skill.scriptCount}}</text>
            <text class="stat-label">话术模板</text>
          </view>
          <view class="stat">
            <text class="stat-num">{{skill.useCount}}</text>
            <text class="stat-label">使用次数</text>
          </view>
          <view class="stat">
            <text class="stat-num">{{skill.avgRating}}</text>
            <text class="stat-label">评分</text>
          </view>
        </view>

        <!-- 示例话术预览 -->
        <view class="script-preview" wx:if="{{skill.preview}}">
          <view class="preview-label">示例话术</view>
          <view class="preview-text">{{skill.preview}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="float-btn" bindtap="addSkill">
    <text class="float-icon">+</text>
  </view>
</view>
