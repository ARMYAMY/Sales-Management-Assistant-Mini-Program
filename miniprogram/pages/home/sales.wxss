/* pages/home/sales.wxss - 销售工作台 */

.home-page {
  padding-bottom: 120rpx;
}

/* 日报提醒横幅 */
.daily-reminder {
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, #FFF7ED 0%, #FFFBEB 100%);
  border-left: 6rpx solid #F59E0B;
  padding: 20rpx 24rpx;
  margin: 16rpx 24rpx 0;
  border-radius: 12rpx;
}

.reminder-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.reminder-text {
  flex: 1;
  font-size: 26rpx;
  color: #92400E;
}

.reminder-action {
  font-size: 26rpx;
  color: #D97706;
  font-weight: 500;
  padding: 6rpx 16rpx;
  background: #FEF3C7;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.reminder-close {
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 8rpx;
}

/* 顶部 */
.home-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 24rpx;
  background: linear-gradient(135deg, #2B6FF2, #1a5bd9);
  color: #FFFFFF;
  border-radius: 0 0 32rpx 32rpx;
}

.header-left { display: flex; flex-direction: column; }

.greeting {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.week-info {
  font-size: 24rpx;
  opacity: 0.85;
}

.header-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
}

/* 指标卡片网格 */
.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  margin-top: -20rpx;
}

.stat-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
  position: relative;
  overflow: hidden;
}

.stat-card--success { border-left: 6rpx solid #22C55E; }
.stat-card--warning { border-left: 6rpx solid #F59E0B; }
.stat-card--danger  { border-left: 6rpx solid #EF4444; }

.stat-label {
  font-size: 24rpx;
  color: #86909C;
  margin-bottom: 12rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.2;
}

.stat-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #86909C;
  margin-left: 4rpx;
}

.stat-desc {
  font-size: 22rpx;
  color: #F59E0B;
  margin-top: 8rpx;
}

.stat-card .progress-bar {
  margin-top: 16rpx;
}

/* 区块 */
.section {
  padding: 24rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.section-header .section-title { margin-bottom: 0; }

.section-more {
  font-size: 26rpx;
  color: #2B6FF2;
}

/* 待办卡片 */
.todo-list { display: flex; flex-direction: column; gap: 16rpx; }

.todo-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.todo-card--high { border-left: 6rpx solid #EF4444; }
.todo-card--medium { border-left: 6rpx solid #F59E0B; }

.todo-icon { font-size: 36rpx; margin-right: 20rpx; flex-shrink:0; }

.todo-body { flex:1; }

.todo-text {
  font-size: 28rpx;
  color: #1A1A1A;
  margin-bottom: 6rpx;
}

.todo-hint {
  font-size: 24rpx;
  color: #86909C;
}

.todo-arrow {
  font-size: 28rpx;
  color: #C9CDD4;
  flex-shrink:0;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  flex-wrap: wrap;
}

.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 140rpx;
  height: 160rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  position: relative;
  z-index: 1;
}

.quick-btn--active {
  opacity: 0.7;
  transform: scale(0.96);
}

.quick-icon { font-size: 48rpx; margin-bottom: 12rpx; }

.quick-label {
  font-size: 24rpx;
  color: #1A1A1A;
}

/* 客户快捷入口 */
.customer-quick-row {
  display: flex;
  gap: 20rpx;
}

.customer-quick-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  text-align: center;
}

.customer-quick-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #2B6FF2;
  margin-bottom: 8rpx;
}

.customer-quick-label {
  font-size: 26rpx;
  color: #86909C;
}

/* 拜访卡片 */
.visit-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.visit-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.visit-customer {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.visit-time {
  font-size: 24rpx;
  color: #86909C;
}

.visit-card-bottom {
  display: flex;
  gap: 16rpx;
}

.visit-stage {
  font-size: 24rpx;
  color: #2B6FF2;
  background: rgba(43,111,242,0.08);
  padding: 4rpx 16rpx;
  border-radius: 4rpx;
}

.visit-result {
  font-size: 24rpx;
  color: #22C55E;
}
