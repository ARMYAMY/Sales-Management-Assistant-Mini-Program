/* pages/train/index.wxss - AI训练入口页 */
.train-page {
  padding-bottom: 48rpx;
  background: #F5F7FA;
  min-height: 100vh;
}

/* 当前对标卡片 */
.benchmark-card {
  margin: 24rpx 32rpx;
  background: linear-gradient(135deg, #2B6FF2, #1a5bd9);
  border-radius: 20rpx;
  padding: 32rpx;
  color: #FFFFFF;
}

.benchmark-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.benchmark-tag {
  font-size: 22rpx;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.benchmark-switch {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

.benchmark-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.benchmark-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
  margin-bottom: 16rpx;
}

.benchmark-score {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.score-value {
  font-size: 32rpx;
  font-weight: 600;
}

.score-change {
  font-size: 26rpx;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

/* 场景列表 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin: 32rpx 32rpx 16rpx;
}

.scenario-list {
  padding: 0 32rpx;
}

.scenario-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.scenario-card:active {
  background: #F8F9FA;
}

.scenario-weak {
  border: 2rpx solid #F59E0B;
}

.scenario-main {
  display: flex;
  align-items: flex-start;
  flex: 1;
}

.scenario-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
  width: 60rpx;
  text-align: center;
  line-height: 1;
}

.scenario-content {
  flex: 1;
}

.scenario-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.scenario-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.scenario-weak-tag {
  font-size: 20rpx;
  color: #F59E0B;
  background: #FFF7ED;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.scenario-desc {
  font-size: 24rpx;
  color: #86909C;
  margin-bottom: 8rpx;
}

.scenario-stats {
  font-size: 22rpx;
  color: #C9CDD4;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}
.scenario-stars {
  display: flex;
  gap: 2rpx;
  margin-left: 4rpx;
}
.sc-star {
  font-size: 22rpx;
}
.sc-star-full {
  color: #F59E0B;
}
.sc-star-empty {
  color: #E5E6EB;
}

.scenario-arrow {
  font-size: 28rpx;
  color: #C9CDD4;
  margin-left: 16rpx;
}

.scenario-custom .scenario-name {
  color: #2B6FF2;
}

/* 成长曲线 */
.growth-section {
  margin: 24rpx 32rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.growth-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.growth-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.growth-arrow {
  font-size: 28rpx;
  color: #C9CDD4;
}

.growth-chart {
  height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 160rpx;
  gap: 16rpx;
}

.chart-bar {
  flex: 1;
  background: linear-gradient(180deg, #2B6FF2, #6B9BF7);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 8rpx;
  position: relative;
  transition: height 0.3s ease;
}

.chart-tooltip {
  position: absolute;
  top: -36rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 20rpx;
  color: #2B6FF2;
  background: #EBF1FE;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.chart-labels {
  display: flex;
  justify-content: space-around;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #86909C;
}

.growth-empty {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #C9CDD4;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
  max-width: 600rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  text-align: center;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.form-input {
  height: 80rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}

.modal-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.btn-cancel, .btn-confirm {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
}

.btn-cancel {
  background: #F5F7FA;
  color: #86909C;
}

.btn-confirm {
  background: #2B6FF2;
  color: #FFFFFF;
}

.btn-cancel::after, .btn-confirm::after {
  border: none;
}
