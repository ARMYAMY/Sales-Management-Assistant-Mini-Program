/* pages/train/growth.wxss - 成长曲线页 */
.growth-page {
  padding-bottom: 48rpx;
  background: #F5F7FA;
  min-height: 100vh;
}

/* 图表卡片 */
.chart-card {
  margin: 24rpx 32rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.chart-avg {
  font-size: 24rpx;
  color: #2B6FF2;
  background: #EBF1FE;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.chart-area {
  height: 360rpx;
}

.chart-line-wrap {
  display: flex;
  height: 100%;
}

.chart-y-labels {
  width: 50rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  font-size: 20rpx;
  color: #C9CDD4;
  text-align: right;
  padding-right: 12rpx;
}

.chart-canvas {
  flex: 1;
  position: relative;
  border-left: 1rpx solid #E5E6EB;
  border-bottom: 1rpx solid #E5E6EB;
}

.chart-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.grid-line {
  height: 1rpx;
  background: #F5F7FA;
}

.chart-points {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.point {
  position: absolute;
  transform: translate(-50%, 50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.point-dot {
  width: 16rpx;
  height: 16rpx;
  background: #2B6FF2;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(43,111,242,0.3);
}

.point-label {
  font-size: 18rpx;
  color: #86909C;
  margin-top: 8rpx;
  white-space: nowrap;
}

/* 维度趋势 */
.dimension-trend {
  margin: 0 32rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.trend-item {
  margin-bottom: 24rpx;
}

.trend-item:last-child {
  margin-bottom: 0;
}

.trend-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.trend-name {
  font-size: 28rpx;
  color: #1A1A1A;
}

.trend-score {
  font-size: 26rpx;
  color: #86909C;
}

.trend-bar {
  height: 12rpx;
  background: #F5F7FA;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.trend-fill {
  height: 100%;
  background: linear-gradient(90deg, #2B6FF2, #6B9BF7);
  border-radius: 6rpx;
}

.trend-change {
  font-size: 22rpx;
}

.trend-up {
  color: #22C55E;
}

.trend-down {
  color: #EF4444;
}

/* 统计卡片 */
.stats-card {
  margin: 0 32rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.stat-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #2B6FF2;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #86909C;
}
