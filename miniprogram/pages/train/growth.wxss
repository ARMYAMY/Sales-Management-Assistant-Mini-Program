.growth-page {
  padding: 0 0 60rpx;
  background: #F5F7FA;
  min-height: 100vh;
}

/* Tab切换 */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 16rpx 32rpx 0;
  gap: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 12rpx 12rpx 0 0;
  gap: 8rpx;
  opacity: 0.6;
}
.tab-item--active {
  opacity: 1;
  background: #EFF4FF;
  border-bottom: 4rpx solid #2B6FF2;
}
.tab-icon { font-size: 36rpx; }
.tab-text { font-size: 26rpx; color: #1D2129; font-weight: 500; }

/* 图表卡片 */
.chart-card {
  background: #fff;
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}
.chart-avg {
  font-size: 24rpx;
  color: #2B6FF2;
  font-weight: 500;
}

/* 图表区域 */
.chart-area { margin-bottom: 32rpx; }
.chart-line-wrap {
  display: flex;
  height: 360rpx;
}
.chart-y-labels {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 8rpx 16rpx 32rpx 0;
  font-size: 20rpx;
  color: #9CA3AF;
  text-align: right;
  width: 60rpx;
  flex-shrink: 0;
}
.chart-canvas {
  flex: 1;
  position: relative;
  border-left: 1rpx solid #E5E7EB;
  border-bottom: 1rpx solid #E5E7EB;
}
.chart-grid {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.grid-line {
  height: 1rpx;
  background: #F3F4F6;
}
.chart-points {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
}
.point {
  position: absolute;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.point-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #2B6FF2;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(43,111,242,0.3);
}
.point-dot--visit { background: #F59E0B; box-shadow: 0 2rpx 8rpx rgba(245,158,11,0.3); }
.point-dot--deal { background: #22C55E; box-shadow: 0 2rpx 8rpx rgba(34,197,94,0.3); }
.point-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #86909C;
}
.point-value {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #2B6FF2;
  font-weight: 500;
  background: rgba(43,111,242,0.08);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}
.chart-path {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
}
.trend-line {
  position: absolute;
  top: 50%;
  left: 5%;
  right: 5%;
  height: 2rpx;
  background: linear-gradient(90deg, #2B6FF2 0%, #60A5FA 100%);
  opacity: 0.3;
}
.trend-line--visit { background: linear-gradient(90deg, #F59E0B 0%, #FCD34D 100%); }
.trend-line--deal { background: linear-gradient(90deg, #22C55E 0%, #86EFAC 100%); }

/* 图表统计 */
.chart-stats {
  display: flex;
  gap: 32rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid #F0F0F0;
}
.chart-stat {
  flex: 1;
  text-align: center;
}
.chart-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D2129;
}
.chart-stat-label {
  font-size: 22rpx;
  color: #86909C;
  margin-top: 8rpx;
}

/* 维度趋势 */
.dimension-trend { margin-top: 32rpx; }
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 20rpx;
}
.trend-list { display: flex; flex-direction: column; gap: 24rpx; }
.trend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.trend-name { font-size: 26rpx; color: #374151; }
.trend-score { font-size: 24rpx; color: #6B7280; }
.trend-bar {
  height: 12rpx;
  background: #F3F4F6;
  border-radius: 6rpx;
  overflow: hidden;
}
.trend-fill {
  height: 100%;
  background: linear-gradient(90deg, #2B6FF2, #60A5FA);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}
.trend-change {
  font-size: 22rpx;
  margin-top: 8rpx;
}
.trend-up { color: #22C55E; }
.trend-down { color: #EF4444; }
