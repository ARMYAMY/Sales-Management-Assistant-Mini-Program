/* pages/train/select-benchmark.wxss */
.select-page {
  padding-bottom: 140rpx;
  background: #F5F7FA;
  min-height: 100vh;
}

.select-tip {
  padding: 24rpx 32rpx;
  font-size: 26rpx;
  color: #86909C;
}

.benchmark-list {
  padding: 0 32rpx;
}

.benchmark-item {
  display: flex;
  align-items: flex-start;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  border: 2rpx solid transparent;
}

.benchmark-selected {
  border-color: #2B6FF2;
  background: #F0F5FF;
}

.benchmark-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #EBF1FE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.benchmark-info {
  flex: 1;
}

.benchmark-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.benchmark-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
}

.benchmark-tag {
  font-size: 20rpx;
  color: #2B6FF2;
  background: #EBF1FE;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.benchmark-desc {
  font-size: 26rpx;
  color: #86909C;
  margin-bottom: 8rpx;
}

.benchmark-meta {
  font-size: 22rpx;
  color: #C9CDD4;
  margin-bottom: 8rpx;
}

.benchmark-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.benchmark-tags .tag {
  font-size: 20rpx;
  color: #86909C;
  background: #F5F7FA;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.benchmark-check {
  width: 44rpx;
  height: 44rpx;
  background: #2B6FF2;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.confirm-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #E5E6EB;
}

.btn-confirm {
  height: 88rpx;
  line-height: 88rpx;
  background: #2B6FF2;
  color: #FFFFFF;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}
