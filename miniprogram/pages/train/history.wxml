<!--pages/train/history.wxml - 训练历史页-->
<view class="container history-page">

  <view class="history-summary">
    <view class="summary-item">
      <view class="summary-num">{{totalCount}}</view>
      <view class="summary-label">总训练</view>
    </view>
    <view class="summary-item">
      <view class="summary-num">{{avgScore}}</view>
      <view class="summary-label">平均分</view>
    </view>
    <view class="summary-item">
      <view class="summary-num">{{bestScore}}</view>
      <view class="summary-label">最高分</view>
    </view>
  </view>

  <view class="history-list">
    <view
      class="history-card"
      wx:for="{{historyList}}"
      wx:key="_id"
      bindtap="viewDetail"
      data-id="{{item._id}}"
    >
      <view class="history-main">
        <view class="history-icon">{{item.scenarioIcon || '💬'}}</view>
        <view class="history-info">
          <view class="history-scenario">{{item.scenarioName}}</view>
          <view class="history-meta">
            <text>{{item.benchmarkName}}</text>
            <text> · {{item.createTime}}</text>
          </view>
        </view>
      </view>
      <view class="history-score">
        <view class="score-num">{{item.totalScore}}</view>
        <view class="score-label">分</view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{historyList.length === 0}}">
      <view class="empty-icon">📝</view>
      <view class="empty-text">还没有训练记录</view>
      <view class="empty-hint">去 AI训练 页开始你的第一次训练吧</view>
    </view>
  </view>

</view>
