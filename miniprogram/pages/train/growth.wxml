<!--pages/train/growth.wxml - 成长曲线页（综合）-->
<view class="container growth-page">

  <!-- Tab切换 -->
  <view class="tab-bar">
    <view class="tab-item {{currentTab === 'train' ? 'tab-item--active' : ''}}"
          bindtap="switchTab" data-tab="train">
      <text class="tab-icon">💬</text>
      <text class="tab-text">训练</text>
    </view>
    <view class="tab-item {{currentTab === 'visit' ? 'tab-item--active' : ''}}"
          bindtap="switchTab" data-tab="visit">
      <text class="tab-icon">📋</text>
      <text class="tab-text">拜访</text>
    </view>
    <view class="tab-item {{currentTab === 'deal' ? 'tab-item--active' : ''}}"
          bindtap="switchTab" data-tab="deal">
      <text class="tab-icon">💰</text>
      <text class="tab-text">成交</text>
    </view>
  </view>

  <!-- 训练曲线 -->
  <view class="chart-card" wx:if="{{currentTab === 'train'}}">
    <view class="chart-header">
      <text class="chart-title">近14天训练评分趋势</text>
      <text class="chart-avg">平均 {{trainAvg}} 分</text>
    </view>
    <view class="chart-area">
      <view class="chart-line-wrap">
        <view class="chart-y-labels">
          <text>100</text><text>75</text><text>50</text><text>25</text><text>0</text>
        </view>
        <view class="chart-canvas">
          <view class="chart-grid"><view class="grid-line" wx:for="{{5}}" wx:key="index"></view></view>
          <view class="chart-points">
            <view class="point" wx:for="{{trainData}}" wx:key="date"
                  style="left: {{item.x}}%; bottom: {{item.score}}%;">
              <view class="point-dot"></view>
              <view class="point-label">{{item.label}}</view>
            </view>
          </view>
          <view class="chart-path" wx:if="{{trainData.length > 1}}">
            <view class="trend-line" style="width: 100%;"></view>
          </view>
        </view>
      </view>
    </view>
    <!-- 统计 -->
    <view class="chart-stats">
      <view class="chart-stat">
        <view class="chart-stat-num">{{trainCount}}</view>
        <view class="chart-stat-label">总训练次数</view>
      </view>
      <view class="chart-stat">
        <view class="chart-stat-num">{{trainBest}}</view>
        <view class="chart-stat-label">最高分</view>
      </view>
    </view>
    <!-- 维度趋势 -->
    <view class="dimension-trend">
      <view class="section-title">各维度趋势</view>
      <view class="trend-list">
        <view class="trend-item" wx:for="{{dimensionTrends}}" wx:key="name">
          <view class="trend-header">
            <text class="trend-name">{{item.name}}</text>
            <text class="trend-score">{{item.current}}/{{item.max}}</text>
          </view>
          <view class="trend-bar">
            <view class="trend-fill" style="width: {{(item.current/item.max)*100}}%;"></view>
          </view>
          <view class="trend-change {{item.change >= 0 ? 'trend-up' : 'trend-down'}}">
            {{item.change >= 0 ? '↑' : '↓'}} {{Math.abs(item.change)}} 分 (近7天)
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 拜访曲线 -->
  <view class="chart-card" wx:if="{{currentTab === 'visit'}}">
    <view class="chart-header">
      <text class="chart-title">近14天拜访次数趋势</text>
      <text class="chart-avg">累计 {{visitTotal}} 次</text>
    </view>
    <view class="chart-area">
      <view class="chart-line-wrap">
        <view class="chart-y-labels">
          <text>5次</text><text>4次</text><text>3次</text><text>2次</text><text>1次</text><text>0</text>
        </view>
        <view class="chart-canvas">
          <view class="chart-grid"><view class="grid-line" wx:for="{{6}}" wx:key="index"></view></view>
          <view class="chart-points chart-points--visit">
            <view class="point point--visit" wx:for="{{visitData}}" wx:key="date"
                  style="left: {{item.x}}%; bottom: {{item.score}}%;">
              <view class="point-dot point-dot--visit"></view>
              <view class="point-label">{{item.label}}</view>
              <view class="point-value">{{item.realCount}}次</view>
            </view>
          </view>
          <view class="chart-path" wx:if="{{visitData.length > 1}}">
            <view class="trend-line trend-line--visit" style="width: 100%;"></view>
          </view>
        </view>
      </view>
    </view>
    <view class="chart-stats">
      <view class="chart-stat">
        <view class="chart-stat-num">{{visitTotal}}</view>
        <view class="chart-stat-label">总拜访次数</view>
      </view>
      <view class="chart-stat">
        <view class="chart-stat-num">{{visitAvgWeek}}</view>
        <view class="chart-stat-label">周均拜访</view>
      </view>
    </view>
  </view>

  <!-- 成交曲线 -->
  <view class="chart-card" wx:if="{{currentTab === 'deal'}}">
    <view class="chart-header">
      <text class="chart-title">近14天成交流趋势</text>
      <text class="chart-avg">累计 ¥{{dealTotalFormatted}}</text>
    </view>
    <view class="chart-area">
      <view class="chart-line-wrap">
        <view class="chart-y-labels">
          <text>高</text><text></text><text></text><text></text><text>低</text><text>0</text>
        </view>
        <view class="chart-canvas">
          <view class="chart-grid"><view class="grid-line" wx:for="{{6}}" wx:key="index"></view></view>
          <view class="chart-points chart-points--deal">
            <view class="point point--deal" wx:for="{{dealData}}" wx:key="date"
                  style="left: {{item.x}}%; bottom: {{item.score}}%;">
              <view class="point-dot point-dot--deal"></view>
              <view class="point-label">{{item.label}}</view>
              <view class="point-value">¥{{item.amountFormatted}}</view>
            </view>
          </view>
          <view class="chart-path" wx:if="{{dealData.length > 1}}">
            <view class="trend-line trend-line--deal" style="width: 100%;"></view>
          </view>
        </view>
      </view>
    </view>
    <view class="chart-stats">
      <view class="chart-stat">
        <view class="chart-stat-num">¥{{dealTotalFormatted}}</view>
        <view class="chart-stat-label">总成交金额</view>
      </view>
      <view class="chart-stat">
        <view class="chart-stat-num">¥{{dealAvgFormatted}}</view>
        <view class="chart-stat-label">日均成交</view>
      </view>
    </view>
  </view>

</view>
