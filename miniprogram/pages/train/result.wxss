/* pages/train/result.wxss - 训练结果页 */
.result-scroll {
  height: 100vh;
  background: #F5F7FA;
}

/* 评分头部 */
.result-header {
  background: linear-gradient(135deg, #2B6FF2, #1a5bd9);
  padding: 32rpx 32rpx 40rpx;
  text-align: center;
  color: #FFFFFF;
  border-radius: 0 0 32rpx 32rpx;
}

.score-ring {
  display: flex;
  justify-content: center;
}

.score-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  border: 6rpx solid rgba(255,255,255,0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-value {
  font-size: 56rpx;
  font-weight: 700;
}

.score-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

.score-change {
  font-size: 22rpx;
  color: #22C55E;
  background: rgba(255,255,255,0.2);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 4rpx;
}

/* Tab 切换 */
.result-tabs {
  display: flex;
  background: #FFFFFF;
  border-bottom: 2rpx solid #F0F1F2;
  margin-bottom: 0;
}
.result-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #86909C;
  position: relative;
}
.result-tab.active {
  color: #2B6FF2;
  font-weight: 600;
}
.result-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 25%;
  width: 50%;
  height: 4rpx;
  background: #2B6FF2;
  border-radius: 2rpx;
}

/* 维度得分 */
.dimension-section {
  margin: 16rpx 32rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.dimension-item {
  margin-bottom: 20rpx;
}

.dimension-item:last-child {
  margin-bottom: 0;
}

.dimension-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.dimension-name {
  font-size: 28rpx;
  color: #1A1A1A;
}

.dimension-score {
  font-size: 26rpx;
  color: #86909C;
}

.dimension-bar {
  height: 16rpx;
  background: #F5F7FA;
  border-radius: 8rpx;
  overflow: hidden;
}

.dimension-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.6s ease;
}

/* 改进建议 */
.improve-section {
  margin: 0 32rpx 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.improve-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
  padding: 12rpx;
  background: #F8F9FA;
  border-radius: 10rpx;
}

.improve-item:last-child {
  margin-bottom: 0;
}

.improve-num {
  width: 40rpx;
  height: 40rpx;
  background: #2B6FF2;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.improve-text {
  font-size: 26rpx;
  color: #1A1A1A;
  line-height: 1.5;
  flex: 1;
}

/* ===== 原始对话样式 ===== */
.chat-section {
  padding: 16rpx 24rpx 0;
}
.chat-intro {
  font-size: 24rpx;
  color: #86909C;
  text-align: center;
  padding: 16rpx 0 20rpx;
  border-bottom: 2rpx solid #F0F1F2;
  margin-bottom: 8rpx;
}
.chat-list {
  padding: 8rpx 0 16rpx;
}
.chat-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  gap: 14rpx;
}
.chat-right {
  flex-direction: row-reverse;
}
.chat-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex-shrink: 0;
}
.ai-avatar {
  background: #6366F1;
}
.user-avatar {
  background: #2B6FF2;
}
.chat-body {
  max-width: 70%;
  display: flex;
  flex-direction: column;
}
.chat-body-right {
  align-items: flex-end;
}
.chat-name {
  font-size: 22rpx;
  color: #86909C;
  margin-bottom: 6rpx;
}
.chat-bubble {
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1A1A1A;
}
.ai-bubble {
  background: #FFFFFF;
  border-radius: 4rpx 16rpx 16rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.user-bubble {
  background: #2B6FF2;
  color: #FFFFFF;
  border-radius: 16rpx 4rpx 16rpx 16rpx;
}
.highlight-bubble {
  background: #FEF3C7;
  color: #92400E;
  border: 2rpx solid #F59E0B;
}
.chat-highlight-note {
  margin-top: 8rpx;
  padding: 10rpx 14rpx;
  background: #FFF7ED;
  border-left: 4rpx solid #F59E0B;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #78350F;
  line-height: 1.5;
}
.chat-time {
  font-size: 20rpx;
  color: #C9CDD4;
  margin-top: 6rpx;
}
.text-right {
  text-align: right;
}

/* 操作按钮 */
.result-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.btn-primary, .btn-secondary {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.btn-primary {
  background: linear-gradient(135deg, #2B6FF2, #1a5bd9);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(43, 111, 242, 0.3);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background: #FFFFFF;
  color: #4E5969;
  border: 2rpx solid #E5E6EB;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-secondary:active {
  background: #F5F7FA;
  transform: scale(0.98);
}

