/* pages/train/result.wxss - 训练结果页 */
.result-scroll {
  height: 100vh;
  background: #F5F7FA;
}

/* 评分头部 */
.result-header {
  background: linear-gradient(135deg, #2B6FF2, #1a5bd9);
  padding: 32rpx 32rpx 40rpx;
  text-align: center;
  color: #FFFFFF;
  border-radius: 0 0 32rpx 32rpx;
}

.score-ring {
  display: flex;
  justify-content: center;
}

.score-circle {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  border: 6rpx solid rgba(255,255,255,0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-value {
  font-size: 56rpx;
  font-weight: 700;
}

.score-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 4rpx;
}

.score-change {
  font-size: 22rpx;
  color: #22C55E;
  background: rgba(255,255,255,0.2);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 4rpx;
}

/* 维度得分 */
.dimension-section {
  margin: 16rpx 32rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 20rpx;
}

.dimension-item {
  margin-bottom: 20rpx;
}

.dimension-item:last-child {
  margin-bottom: 0;
}

.dimension-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.dimension-name {
  font-size: 28rpx;
  color: #1A1A1A;
}

.dimension-score {
  font-size: 26rpx;
  color: #86909C;
}

.dimension-bar {
  height: 16rpx;
  background: #F5F7FA;
  border-radius: 8rpx;
  overflow: hidden;
}

.dimension-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.6s ease;
}

/* 改进建议 */
.improve-section {
  margin: 0 32rpx 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.improve-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
  padding: 12rpx;
  background: #F8F9FA;
  border-radius: 10rpx;
}

.improve-item:last-child {
  margin-bottom: 0;
}

.improve-num {
  width: 40rpx;
  height: 40rpx;
  background: #2B6FF2;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.improve-text {
  font-size: 26rpx;
  color: #1A1A1A;
  line-height: 1.5;
  flex: 1;
}

/* 操作按钮 */
.result-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.btn-primary, .btn-secondary {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.btn-primary {
  background: linear-gradient(135deg, #2B6FF2, #1a5bd9);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(43, 111, 242, 0.3);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-secondary {
  background: #FFFFFF;
  color: #4E5969;
  border: 2rpx solid #E5E6EB;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-secondary:active {
  background: #F5F7FA;
  transform: scale(0.98);
}
