/* pages/login/index.wxss */
.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background-color: #FFFFFF;
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* Logo 区域 */
.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 160rpx;
  margin-bottom: 80rpx;
}

.logo-wrap {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.logo-icon {
  font-size: 64rpx;
  margin-right: 16rpx;
}

.logo-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.logo-slogan {
  font-size: 28rpx;
  color: #86909C;
}

/* 表单 */
.login-form {
  width: 100%;
}

.input-wrap {
  display: flex;
  align-items: center;
  height: 96rpx;
  background-color: #F5F7FA;
  border-radius: 8rpx;
  padding: 0 24rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.input-wrap--focus {
  border-color: #2B6FF2;
  background-color: #FFFFFF;
}

.input-prefix {
  font-size: 32rpx;
  color: #1A1A1A;
  margin-right: 16rpx;
  white-space: nowrap;
}

.input-wrap .form-input {
  flex: 1;
  height: 96rpx;
  background: transparent;
  padding: 0;
}

/* 验证码按钮 */
.code-btn {
  white-space: nowrap;
  font-size: 28rpx;
  color: #2B6FF2;
  padding: 0 8rpx;
}

.code-btn--disabled {
  color: #C9CDD4;
}

/* 登录按钮 */
.login-btn {
  margin-top: 48rpx;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 36rpx;
}

.btn-primary--disabled {
  background-color: #B3D4FC !important;
  color: rgba(255, 255, 255, 0.7) !important;
}

/* 错误提示 */
.form-error {
  font-size: 24rpx;
  color: #EF4444;
  margin-top: 8rpx;
  padding-left: 8rpx;
}

/* 协议 */
.login-agreement {
  position: fixed;
  bottom: 80rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 24rpx;
  color: #86909C;
}

.login-agreement .link {
  color: #2B6FF2;
}
