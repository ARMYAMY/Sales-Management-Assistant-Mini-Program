<!--pages/alerts/index.wxml - 风险预警页-->
<view class="page">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">←</view>
    <view class="nav-title">风险预警</view>
    <view class="nav-placeholder"></view>
  </view>

  <view class="alert-list">
    <view class="alert-card {{item.level}}" wx:for="{{alerts}}" wx:key="id">
      <view class="alert-top">
        <view class="alert-level-tag {{item.level}}">
          {{item.level === 'high' ? '高风险' : item.level === 'medium' ? '中风险' : '低风险'}}
        </view>
        <view class="alert-time">{{item.time}}</view>
      </view>
      <view class="alert-sales">{{item.sales}}</view>
      <view class="alert-text">{{item.text}}</view>
    </view>
  </view>

  <view style="height:40rpx;"></view>
</view>
