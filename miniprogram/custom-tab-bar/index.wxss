/* custom-tab-bar/index.wxss - 自定义 Tab 栏样式 */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(120rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #E5E6EB;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar-inner {
  display: flex;
  height: 120rpx;
  align-items: center;
}

/* 普通 Tab 项 */
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
}

.tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 6rpx;
}

.tab-icon-text {
  font-size: 40rpx;
  line-height: 1;
}

.tab-text {
  font-size: 20rpx;
  color: #86909C;
  line-height: 1.2;
}

.tab-text--active {
  color: #2B6FF2;
  font-weight: 600;
}

/* 中心凸起按钮 - 改为底部内嵌式 */
.tab-item--center {
  position: relative;
}

.center-btn {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2B6FF2, #1a5bd9);
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(43, 111, 242, 0.3);
  border: 4rpx solid #FFFFFF;
  z-index: 10;
}

.center-btn:active {
  opacity: 0.85;
  transform: translateX(-50%) scale(0.95);
}

.center-icon {
  font-size: 32rpx;
  line-height: 1;
}

.center-text {
  font-size: 18rpx;
  margin-top: 2rpx;
  font-weight: 600;
}
