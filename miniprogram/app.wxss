/* app.wxss - 销售助手全局样式 */

/* ========== 设计变量（通过 class 映射） ========== */
/* 主色：#2B6FF2  成功：#22C55E  警告：#F59E0B  危险：#EF4444 */
/* 背景：#F5F7FA  卡片：#FFFFFF */
/* 主文字：#1A1A1A  次要文字：#86909C  占位符：#C9CDD4 */

page {
  background-color: #F5F7FA;
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 32rpx;
  color: #1A1A1A;
  line-height: 1.5;
  box-sizing: border-box;
}

/* ========== 通用容器 ========== */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-body {
  padding: 24rpx 32rpx 48rpx;
}

/* ========== 颜色工具类 ========== */
.text-primary { color: #2B6FF2; }
.text-success { color: #22C55E; }
.text-warning { color: #F59E0B; }
.text-danger  { color: #EF4444; }
.text-secondary { color: #86909C; }
.text-placeholder { color: #C9CDD4; }
.text-main { color: #1A1A1A; }

.bg-primary { background-color: #2B6FF2; }
.bg-success { background-color: #22C55E; }
.bg-warning { background-color: #F59E0B; }
.bg-danger  { background-color: #EF4444; }
.bg-white { background-color: #FFFFFF; }
.bg-page { background-color: #F5F7FA; }

/* ========== 字号 ========== */
.text-xs  { font-size: 28rpx; }
.text-base { font-size: 32rpx; }
.text-lg  { font-size: 36rpx; }
.text-xl  { font-size: 40rpx; }

/* ========== 卡片 ========== */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.card-sm {
  background-color: #FFFFFF;
  border-radius: 8rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

/* ========== 按钮 ========== */
.btn-primary {
  background-color: #2B6FF2;
  color: #FFFFFF;
  border-radius: 4rpx;
  font-size: 32rpx;
  padding: 24rpx 0;
  text-align: center;
  border: none;
}

.btn-primary::after { border: none; }

.btn-primary[disabled] {
  background-color: #B3D4FC;
  color: rgba(255, 255, 255, 0.7);
}

.btn-outline {
  background-color: #FFFFFF;
  color: #2B6FF2;
  border: 2rpx solid #2B6FF2;
  border-radius: 4rpx;
  font-size: 32rpx;
  padding: 22rpx 0;
  text-align: center;
}

.btn-outline::after { border: none; }

/* ========== 表单 ========== */
.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #1A1A1A;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.form-label .required {
  color: #EF4444;
  margin-right: 6rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background-color: #F5F7FA;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}

.form-input-placeholder {
  color: #C9CDD4;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background-color: #F5F7FA;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 32rpx;
  color: #1A1A1A;
  box-sizing: border-box;
}

/* ========== 弹性布局 ========== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-1 { flex: 1; }

/* ========== 文字截断 ========== */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 分割线 ========== */
.divider {
  width: 100%;
  height: 2rpx;
  background-color: rgba(0, 0, 0, 0.06);
  margin: 24rpx 0;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.empty-state .empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
}

.empty-state .empty-text {
  font-size: 32rpx;
  color: #86909C;
  text-align: center;
}

.empty-state .empty-action {
  margin-top: 32rpx;
}

/* ========== 进度条 ========== */
.progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: #F5F7FA;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar .progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-fill.success { background-color: #22C55E; }
.progress-fill.warning { background-color: #F59E0B; }
.progress-fill.danger  { background-color: #EF4444; }

/* ========== 骨架屏 ========== */
.skeleton {
  background: linear-gradient(90deg, #F0F0F0 25%, #E0E0E0 50%, #F0F0F0 75%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.5s ease-in-out infinite;
  border-radius: 8rpx;
}

@keyframes skeleton-loading {
  0% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}

/* ========== 安全区适配 ========== */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
